{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "static",
    "rootDir": "frontend",
    "noEmitOnError": true
  },
  "include": ["frontend/**/*.ts"]
}
